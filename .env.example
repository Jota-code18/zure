# Supabase (Project Settings > API). A chave publicável é pública: a segurança vem das regras (RLS) do banco.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Observabilidade (opcional). Cada fornecedor só liga se as variáveis dele existirem.
VITE_SENTRY_DSN=
VITE_DATADOG_APPLICATION_ID=
VITE_DATADOG_CLIENT_TOKEN=
VITE_DATADOG_SITE=datadoghq.com
VITE_NEW_RELIC_LICENSE_KEY=
VITE_NEW_RELIC_APPLICATION_ID=
VITE_NEW_RELIC_ACCOUNT_ID=
VITE_NEW_RELIC_TRUST_KEY=
VITE_NEW_RELIC_AGENT_ID=
VITE_OTEL_EXPORTER_OTLP_ENDPOINT=
# formato: chave=valor,chave2=valor2
VITE_OTEL_EXPORTER_OTLP_HEADERS=
VITE_TRACES_SAMPLE_RATE=0.2
